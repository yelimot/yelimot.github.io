---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('guitar');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="space-y-6">
    <header class="space-y-2">
      <a href="/guitar" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-link)]">
        &larr; Back to Guitar
      </a>
      <h1 class="font-display text-3xl font-bold">{post.data.title}</h1>
      <time class="text-sm text-[var(--color-text-secondary)]">{post.data.date}</time>
    </header>
    <div class="prose prose-slate dark:prose-invert max-w-none text-[var(--color-text-secondary)] leading-relaxed [&_h2]:text-[var(--color-text)] [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-8 [&_h2]:mb-3 [&_h1]:hidden">
      <Content />
    </div>
  </article>
</BaseLayout>
