---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('engineering')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Engineering" description="Engineering blog posts by Yasar Polatli">
  <section class="space-y-2">
    <h1 class="font-display text-3xl font-bold">Engineering</h1>
    <p class="text-[var(--color-text-secondary)] text-sm mb-6">
      Thoughts on software, systems, and building things.
    </p>
    {posts.length === 0 ? (
      <p class="text-[var(--color-text-secondary)]">No posts yet.</p>
    ) : (
      posts.map(post => (
        <BlogPostCard
          title={post.data.title}
          description={post.data.description}
          href={`/engineering/${post.id}`}
          date={post.data.date}
        />
      ))
    )}
  </section>
</BaseLayout>
