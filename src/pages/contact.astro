---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Yasar Polatli">
  <section class="space-y-6">
    <h1 class="font-display text-3xl font-bold">Contact</h1>
    <p class="text-[var(--color-text-secondary)] leading-relaxed">
      Feel free to reach out through any of the channels below.
    </p>
    <ul class="space-y-3 text-sm">
      <li>
        <span class="text-[var(--color-text-secondary)]">Email:</span>
        <a href="mailto:m.yasar.polatli@gmail.com">m.yasar.polatli@gmail.com</a>
      </li>
      <li>
        <span class="text-[var(--color-text-secondary)]">GitHub:</span>
        <a href="https://github.com/yelimot" target="_blank" rel="noopener">yelimot</a>
      </li>
      <li>
        <span class="text-[var(--color-text-secondary)]">LinkedIn:</span>
        <a href="https://linkedin.com/in/yelimot" target="_blank" rel="noopener">Yasar Polatli</a>
      </li>
    </ul>
  </section>
</BaseLayout>
